{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["tests/**/*.ts", "pages/**/*.ts", "api/**/*.ts", "fixtures/**/*.ts", "test-data/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
